{
  "name": "do-day",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "concurrently -n FRONT,BACK -c cyan,magenta \"yarn start\" \"nodemon server.js\"",
    "kill:expo": "kill-port 8081 19000 19001 19002",
    "kill:back": "kill-port 3000",
    "kill:all": "yarn kill:expo && yarn kill:back",
    "dev:clean": "yarn kill:all && yarn dev",
    "up": "yarn dev",
    "down": "yarn kill:all"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "axios": "^1.12.1",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "expo": "^54.0.13",
    "expo-status-bar": "~3.0.8",
    "express": "^5.1.0",
    "framer-motion": "^12.23.18",
    "openai": "^5.20.2",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "wait-on": "^9.0.1"
  }
}
